# Environment variables (target project, not this repo)
# These are pushed to Cloudflare Workers as secrets

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 9router (for vision — only needed if using OpenAI-compatible models)
# Not required for native Gemini/Claude providers
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=sk-your-key-here

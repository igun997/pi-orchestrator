{
  "name": "pi-orchestrators",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "cursor:install": "node scripts/install-cursor-compat.mjs",
    "cursor:install:global": "node scripts/install-cursor-compat.mjs --global",
    "cursor:uninstall": "node scripts/uninstall-cursor-compat.mjs",
    "cursor:uninstall:global": "node scripts/uninstall-cursor-compat.mjs --global"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
